          "docs": "Modeled from Vagaro's documented capability summary and the confirmed Business Location webhook payload fields."
        },
        {
          "info": {
            "name": "Get a business location (modeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vagaro.com/{region}/api/v2/locations/:businessId",
            "params": [
              {
                "name": "businessId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a business location (modeled)"
        }
      ]
    }
  ],
  "bundled": true
}