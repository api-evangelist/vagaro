{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vagaro Enterprise Business API (Partial, Community-Modeled) Appointments Employees API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Employees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List employees / service providers (modeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vagaro.com/{region}/api/v2/employees",
            "params": [
              {
                "name": "businessId",
                "value": "",
                "type": "query",
                "description": "Modeled - filter to a single business location."
              }
            ]
          },
          "docs": "Modeled from Vagaro's documented capability summary and the confirmed Employee webhook payload fields."
        },
        {
          "info": {
            "name": "Get an employee (modeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vagaro.com/{region}/api/v2/employees/:employeeId",
            "params": [
              {
                "name": "employeeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an employee (modeled)"
        }
      ]
    }
  ],
  "bundled": true
}